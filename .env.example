# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored. These are local-only dev values — never reuse in production.

# --- Postgres ---
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis_local_dev
POSTGRES_DB=praxis_buchung
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
# Host is the compose service name "postgres" (reachable on the compose network).
DATABASE_URL=postgresql://praxis:praxis_local_dev@postgres:5432/praxis_buchung

# --- Frontend ---
FRONTEND_PORT=4200

# --- Mailpit (local mail catcher) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
