# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored. These are local-only dev values — never reuse in production.

# --- Postgres ---
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis_local_dev
POSTGRES_DB=praxis_buchung
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
# Used by host-run tooling (e.g. the Prisma CLI from M2), so the host is
# "localhost". Inside Docker the backend service overrides DATABASE_URL to use
# the compose-network host "postgres" (see docker-compose.yml).
DATABASE_URL=postgresql://praxis:praxis_local_dev@localhost:5432/praxis_buchung

# --- Frontend ---
FRONTEND_PORT=4200

# --- Email ---
# Sender address and the public base URL the cancellation link points at. Inside
# Docker the backend uses SMTP host "mailpit"; host-run tooling defaults to
# localhost:1025 (Mailpit's SMTP port).
MAIL_FROM=praxis@physio-aarau.example
PUBLIC_BASE_URL=http://localhost:4200

# --- Mailpit (local mail catcher) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
