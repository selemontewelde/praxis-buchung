# Dependencies
node_modules/

# Build output
dist/
build/
.angular/
*.tsbuildinfo

# Prisma generated client (regenerated on install via `prisma generate`)
backend/src/generated/

# The practice config is TypeScript source only; never commit compiled output.
config/*.js
config/*.d.ts
config/*.js.map

# Environment / secrets
.env
.env.*
!.env.example
!infra/.env.prod.example
*.local

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Installed agent skills — reproducible via `npx skills add mattpocock/skills`
# from the committed skills-lock.json; the payloads themselves are not vendored.
.claude/skills/
.agents/
