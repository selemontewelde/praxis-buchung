# The Angular (frontend) and NestJS (backend) workspaces ship different major
# versions of the Vite/Vitest toolchain. npm 10's peer-dependency resolver crashes
# on that cross-workspace graph ("Cannot read properties of null (reading 'edgesOut')").
# legacy-peer-deps skips that resolution step so the hoisted workspace install (and
# `npm ci` in CI) completes. Revisit once npm ships the arborist fix.
legacy-peer-deps=true
