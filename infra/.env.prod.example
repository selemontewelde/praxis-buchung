# Production environment for compose.prod.yml.
#
# Copy to `.env` on the SERVER (next to compose.prod.yml) and fill in real
# values: `cp .env.prod.example .env`. Never commit the real .env.
# The deploy job's credentials are GitHub Actions secrets, NOT part of this file
# (see the deploy job in .github/workflows/ci.yml): SSH_HOST, SSH_USER, SSH_KEY,
# DEPLOY_PATH, and GHCR_PAT (a read:packages token to pull private images). The
# deploy also stays dormant until the repo variable DEPLOY_ENABLED is "true".

# --- Domain & TLS (Caddy) ---
# The public domain that points (A/AAAA record) at this server. Caddy fetches a
# Let's Encrypt certificate for it automatically. Use `localhost` for a local
# prod-like test (Caddy then serves HTTPS with its internal CA).
DOMAIN=praxis.example.com
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=admin@example.com

# --- Images ---
# Which published image tag to run. `latest` tracks the newest merge to main;
# pin to a `sha-<commit>` tag to deploy/rollback a specific build.
IMAGE_TAG=latest

# --- Postgres ---
# Use strong, unique values in production (the DATABASE_URL is built from these).
POSTGRES_USER=praxis
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=praxis_buchung

# --- Backend ---
# Public base URL used in outgoing emails (e.g. the cancellation link). Must be
# the HTTPS site.
PUBLIC_BASE_URL=https://praxis.example.com

# --- Email (SMTP) ---
# Sender address and the SMTP relay for outgoing patient emails.
MAIL_FROM=praxis@praxis.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Credentials for a real provider. Leave empty for an unauthenticated relay (or
# local Mailpit). When set, the connection requires TLS so the password is never
# sent in clear: STARTTLS on port 587, or set SMTP_SECURE=true for implicit TLS
# on port 465. SMTP_PASS is a secret.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Backups ---
# The backup service dumps the database daily into ./backups on the server.
# How many days of gzipped dumps to keep.
BACKUP_RETENTION_DAYS=7
# Hour of day (server/TZ local, 0-23) to run the backup.
BACKUP_HOUR=3
# Timezone for the backup schedule (and anything else TZ-aware).
TZ=Europe/Zurich
