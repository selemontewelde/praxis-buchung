# Edge reverse proxy for the production stack.
#
# Caddy gets a real Let's Encrypt certificate automatically when {$DOMAIN} is a
# public domain pointing at this server; for DOMAIN=localhost it serves HTTPS
# with its own internal CA (handy for local prod-like verification).

{
	# ACME contact address for Let's Encrypt (ignored for the internal/localhost CA).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Site-wide security headers (cover both the SPA and the API).
	header {
		# HSTS: force HTTPS for a year (Caddy already redirects; this tells browsers).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Conservative CSP. 'unsafe-inline' for styles is required because Angular
		# injects component styles as <style> elements; scripts are external only.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		# Don't advertise the server software.
		-Server
	}

	# API calls go to the NestJS backend...
	handle /api/* {
		reverse_proxy backend:3000
	}

	# ...and so does the backend's /health endpoint, so an external uptime monitor
	# can probe the full path (edge -> backend -> database) at a stable public URL.
	# The backend has no global /api prefix, so /health lives at the root; without
	# this route it would fall through to the SPA and never reach the DB check.
	handle /health {
		reverse_proxy backend:3000
	}

	# ...everything else is the Angular SPA served by nginx.
	handle {
		reverse_proxy frontend:8080
	}
}
